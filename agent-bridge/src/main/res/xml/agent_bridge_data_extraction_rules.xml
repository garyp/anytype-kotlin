<?xml version="1.0" encoding="utf-8"?>
<!--
    Agent approvals are bound to this device's apps and keys: never back them up or move them.
    :app has no dataExtractionRules of its own; Task 12 references this file from the app
    manifest (android:dataExtractionRules). Cloud backup is already off app-wide.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="agent_bridge.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="agent_bridge.xml" />
    </device-transfer>
</data-extraction-rules>
