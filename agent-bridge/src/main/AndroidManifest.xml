<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The consent and access screens hide other apps' overlays (tapjacking). -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <application>
        <!-- Agent apps bind here. Disabled below API 35, where caller verification is missing. -->
        <service
            android:name="com.anytypeio.anytype.agentbridge.AgentBridgeService"
            android:enabled="@bool/agent_bridge_enabled"
            android:exported="true"
            tools:targetApi="35">
            <intent-filter>
                <action android:name="io.anytype.agentbridge.BIND" />
            </intent-filter>
        </service>

        <!-- Agent apps start this for result, with setShareIdentityEnabled(true), to ask for access. -->
        <activity
            android:name="com.anytypeio.anytype.agentbridge.consent.AgentApprovalActivity"
            android:enabled="@bool/agent_bridge_enabled"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            tools:targetApi="35">
            <intent-filter>
                <action android:name="io.anytype.agentbridge.APPROVE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
