<?xml version="1.0" encoding="utf-8"?>
<!--
    Rules for Android 12+. Task 12 references this file from the app manifest
    (android:dataExtractionRules); :app has none of its own.

    Once android:dataExtractionRules is set, Android 12+ ignores android:fullBackupContent, so both
    sections below must be at least as strict as :app's res/xml/my_backup_rules.xml, which excludes
    every shared-preferences file. Keep them in step with that file.

    api_bridge.xml holds the app approvals. They are bound to this device's apps and keys, so
    they must never be backed up or transferred. The sharedpref "." exclude covers that file; it
    is also listed by name so a later loosening of "." cannot leak it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="api_bridge.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="api_bridge.xml" />
    </device-transfer>
</data-extraction-rules>
